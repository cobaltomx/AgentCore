# ============================================================
# AgentCore — Variables de Entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas .env a git
# ============================================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_NAME=AgentCore
APP_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentcore
POSTGRES_USER=agentcore
POSTGRES_PASSWORD=localdev123
DATABASE_URL=postgresql://agentcore:localdev123@localhost:5432/agentcore

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=3600        # segundos que dura una sesión de conversación
# PRODUCCIÓN: contraseña obligatoria de Redis (compose.prod la exige).
# En prod, REDIS_URL debe llevar la auth: redis://:LA_PASSWORD@redis:6379
REDIS_PASSWORD=

# --- Auth ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_STRING_ALEATORIO_LARGO
JWT_EXPIRES_IN=7d
COOKIE_SECRET=CAMBIA_ESTO_TAMBIEN

# --- Producción: dominio fijo y webhooks ---
# Dominio público con TLS (lo usa Caddy en compose.prod y los webhooks de Twilio).
PUBLIC_DOMAIN=app.tudominio.com
# URL base pública (https). Si se define, tiene prioridad sobre ngrok para los
# webhooks/enlaces. Debe coincidir con PUBLIC_DOMAIN.
PUBLIC_URL=https://app.tudominio.com
# Validación de firma de Twilio (anti-spoofing). En producción déjalo en true.
TWILIO_VALIDATE_SIGNATURE=true

# --- Email transaccional (reset de contraseña, avisos) ---
# Proveedor: Resend (API HTTP, sin dependencias). Si se deja vacío, el sistema
# degrada con elegancia (en dev devuelve el link en la respuesta).
RESEND_API_KEY=
EMAIL_FROM="AgentCore <no-reply@tudominio.com>"

# --- LLMs ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Modelo default por tipo de tarea
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_COMPLEX_MODEL=claude-sonnet-4-20250514
LLM_FAST_MODEL=gpt-4o-mini

# --- Voz: Speech-to-Text ---
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=es-419         # español latinoamericano

# --- Voz: Text-to-Speech ---
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=...  # ID de voz en español de ElevenLabs

# --- Telefonía ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_DEFAULT_NUMBER=+521...    # número Twilio para outbound

# --- WhatsApp (Meta Cloud API) ---
META_WHATSAPP_TOKEN=...
META_PHONE_NUMBER_ID=...
META_VERIFY_TOKEN=WEBHOOK_VERIFY_SECRET   # tú lo defines

# --- Agendamiento ---
CALCOM_API_KEY=...
CALCOM_BASE_URL=https://api.cal.com/v1

# --- Facturación (Fase 6) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Storage (grabaciones, docs) ---
# Cloudflare R2 o S3 compatible
S3_ENDPOINT=https://...r2.cloudflarestorage.com
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
S3_BUCKET=agentcore-recordings

# --- Logs ---
LOG_LEVEL=debug                  # debug | info | warn | error
